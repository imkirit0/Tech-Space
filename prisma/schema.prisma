generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled (pgBouncer) — app runtime
  directUrl = env("DIRECT_URL")     // direct — migrations
}

enum Role {
  EMPLOYEE
  MANAGER
}
enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model User {
  id          String     @id @default(cuid())
  email        String?    @unique
  // Login ID, stored lowercase. Null = account can't sign in (legacy/seed rows).
  username     String?    @unique
  // scrypt hash: "scrypt$<salt hex>$<key hex>" (see lib/password.ts).
  passwordHash String?
  // Access to the tech ticket desk.
  tech         Boolean    @default(false)
  // Switched-off accounts can't sign in; their history stays.
  active       Boolean    @default(true)
  name        String
  designation String?
  phone       String?    // WhatsApp number, normalised to digits with country code (e.g. 919847012345)
  role        Role       @default(EMPLOYEE)
  createdAt   DateTime   @default(now())
  activities  Activity[]
  locks       PeriodLock[]
  ticketsCreated Ticket[] @relation("TicketCreator")
  ticketsTaken   Ticket[] @relation("TicketTaker")
  ticketsSolved  Ticket[] @relation("TicketSolver")
  ticketForwards TicketForward[] @relation("ForwardActor")
  ticketAttachments TicketAttachment[] @relation("AttachmentUploader")
  ticketNotes    TicketNote[] @relation("NoteAuthor")
  tasksAssigned  Task[]       @relation("TaskAssignee")
  tasksCreated   Task[]       @relation("TaskCreator")
  taskUpdates    TaskUpdate[] @relation("TaskUpdateAuthor")
  taskReads      TaskRead[]
}

model Activity {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeName String
  designation  String
  date         DateTime @db.Date
  activity     String
  description  String?
  assignedBy   String
  status       Status
  deadline     DateTime? @db.Date
  timeTaken    Decimal  @db.Decimal(5, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model PeriodLock {
  id         String   @id @default(cuid())
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  label      String?
  reason     String?
  lockedById String
  lockedBy   User     @relation(fields: [lockedById], references: [id])
  lockedAt   DateTime @default(now())

  @@index([startDate, endDate])
}

enum TicketSource {
  PHONE
  WHATSAPP
  EMAIL
  WALK_IN
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  TAKEN_UP
  SOLVED
  DUPLICATE
  FORWARDED
}

enum TicketCategory {
  TECH
  NON_TECH
}

model Ticket {
  id             String         @id @default(cuid())
  num            Int            @unique @default(autoincrement())
  title          String
  description    String?
  contactName    String
  contactPhone   String
  branch         String?
  source         TicketSource
  ipAddress      String?
  assetId        String?
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  category       TicketCategory @default(TECH)
  forwardedTo    String?
  createdById    String
  createdBy      User           @relation("TicketCreator", fields: [createdById], references: [id])
  takenById      String?
  takenBy        User?          @relation("TicketTaker", fields: [takenById], references: [id])
  takenAt        DateTime?
  solvedById     String?
  solvedBy       User?          @relation("TicketSolver", fields: [solvedById], references: [id])
  solvedAt       DateTime?
  resolutionNote String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  forwards       TicketForward[]
  attachments    TicketAttachment[]
  notes          TicketNote[]

  @@index([status, priority])
  @@index([contactPhone])
}

model TicketForward {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  to       String
  reason   String
  byId     String
  by       User     @relation("ForwardActor", fields: [byId], references: [id])
  at       DateTime @default(now())

  @@index([ticketId])
}

model TicketNote {
  id       String   @id @default(cuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  note     String
  byId     String
  by       User     @relation("NoteAuthor", fields: [byId], references: [id])
  at       DateTime @default(now())

  @@index([ticketId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

// ── Tasks: manager-assigned work with a Slack-style update thread ──

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Task {
  id               String         @id @default(cuid())
  num              Int            @unique @default(autoincrement())
  title            String
  description      String?
  priority         TicketPriority @default(MEDIUM)
  status           TaskStatus     @default(TODO)
  dueDate          DateTime?      @db.Date
  // Null = "up for grabs": on the team board until someone takes it up.
  assigneeId       String?
  assignee         User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Shared tasks sit on the team board: everyone can see and follow them.
  shared           Boolean        @default(false)
  createdById      String
  createdBy        User           @relation("TaskCreator", fields: [createdById], references: [id])
  // Denormalised "last message" so list views and unread badges need no join over updates.
  lastActivityAt   DateTime       @default(now())
  lastActivityById String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  updates          TaskUpdate[]
  reads            TaskRead[]

  @@index([assigneeId, status])
  @@index([shared, status])
  @@index([createdById])
  @@index([lastActivityAt])
}

model TaskUpdate {
  id        String      @id @default(cuid())
  taskId    String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  body      String
  // Set when this update moved the task to a new status.
  statusTo  TaskStatus?
  createdAt DateTime    @default(now())

  @@index([taskId, createdAt])
}

model TaskRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([userId, taskId])
}
